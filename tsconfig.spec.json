{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["vite/client", "node", "jest"]
  },
  "include": [
    "src/**/*.test.js",
    "src/**/*.test.jsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.spec.jsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**/*.js",
    "src/**/__tests__/**/*.jsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "jest.setup.js"
  ]
}